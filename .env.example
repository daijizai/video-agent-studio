# NO SECRETS HERE. This file only documents non-secret startup options.
# Actual credentials are stored OUTSIDE the repository by the local settings UI.
# Default: ../.video-agent-studio-private/credentials.json (0700 directory / 0600 file)
# Optional explicit absolute path, always outside this repository:
# STUDIO_SECRET_FILE=/absolute/private/directory/credentials.json
# Paid generation remains closed until a concrete human-approved trial budget exists.
STUDIO_ENABLE_PAID_GENERATION=false
